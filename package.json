{
  "name": "janus-note",
  "displayName": "Janus Note",
  "description": "Human Markdown Notes & Machine-Operable Companion Files with AI Assistance",
  "version": "0.1.0",
  "publisher": "marc2016",
  "repository": {
    "type": "git",
    "url": "https://github.com/marc2016/janus-note-vs"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Notebooks",
    "AI"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:janus.notesView",
    "onView:janus.calendarDayDetailsView",
    "onView:janus.chatView"
  ],
  "contributes": {
    "configuration": {
      "title": "Janus Note",
      "properties": {
        "janus.notesRoot": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Relative path to the notes root directory within the workspace. If empty, the workspace root is used."
        },
        "janus.initialized": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Indicates whether the Janus notes root has been initialized."
        },
        "janus.includeFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Additional workspace folders to display as pure Markdown notes directories in the Janus Notes sidebar."
        },
        "janus.ai.provider": {
          "type": "string",
          "enum": [
            "vscode-lm",
            "ollama",
            "openai",
            "anthropic",
            "gemini",
            "custom"
          ],
          "default": "vscode-lm",
          "description": "Active AI provider used by Janus Note for task generation."
        },
        "janus.ai.modelId": {
          "type": "string",
          "default": "",
          "description": "Active AI model identifier for task generation (e.g. gpt-4o, claude-3-5-sonnet, llama3.3, gemini-2.5-flash)."
        },
        "janus.ai.ollamaBaseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for a local Ollama server."
        },
        "janus.ai.customBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "Base URL for an OpenAI-compatible custom endpoint (e.g. OpenRouter, LM Studio, vLLM)."
        },
        "janus.ai.inboxSortConfirm": {
          "type": "boolean",
          "default": true,
          "description": "Show a preview confirmation list before sorting inbox.md entries into notes and folders."
        },
        "janus.export.browserPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Custom executable path to a Chromium-based browser (Chrome, Edge, Brave, Chromium) used for PDF export. If empty, standard system locations are searched automatically."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "janus-notes",
          "title": "Janus Note",
          "icon": "resources/janus-icon.svg"
        }
      ]
    },
    "views": {
      "janus-notes": [
        {
          "id": "janus.notesView",
          "name": "Notes"
        },
        {
          "id": "janus.calendarDayDetailsView",
          "name": "Tagesdetails",
          "type": "webview"
        },
        {
          "id": "janus.chatView",
          "name": "KI & Suche",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "janus.notesView",
        "contents": "Dieser Ordner enthält Projektdateien (z. B. Quellcode).\nWir empfehlen, einen separaten Notizen-Ordner zu konfigurieren oder bestehende Ordner zu verknüpfen.\n[Notizen-Ordner festlegen](command:janus.setNotesRoot)\n[Vorhandenen Ordner verknüpfen](command:janus.addLinkedFolder)\n[Trotzdem hier initialisieren](command:janus.initNotesRoot)",
        "when": "!janus.isInitialized && janus.hasNonNoteFiles && !janus.hasLinkedFolders"
      },
      {
        "view": "janus.notesView",
        "contents": "Janus Notizen sind noch nicht initialisiert.\nErstelle jetzt deinen Notizen-Ordner mit einer initialen inbox.md oder verknüpfe einen bestehenden Ordner.\n[Notizen initialisieren](command:janus.initNotesRoot)\n[Vorhandenen Ordner verknüpfen](command:janus.addLinkedFolder)",
        "when": "!janus.isInitialized && !janus.hasNonNoteFiles && !janus.hasLinkedFolders"
      }
    ],
    "commands": [
      {
        "command": "janus.addLinkedFolder",
        "title": "Janus: Ordner verknüpfen...",
        "icon": "$(folder-library)"
      },
      {
        "command": "janus.removeLinkedFolder",
        "title": "Janus: Aus verknüpften Notizen entfernen",
        "icon": "$(close)"
      },
      {
        "command": "janus.openCompanion",
        "title": "Janus: Open Companion File"
      },
      {
        "command": "janus.createTasksCompanion",
        "title": "Janus: Create Tasks Companion (*.tasks.json)"
      },
      {
        "command": "janus.createChartCompanion",
        "title": "Janus: Create Diagram Companion (*.chart.json)"
      },
      {
        "command": "janus.openMarkdownEditor",
        "title": "Janus: Open in Rich Markdown Editor"
      },
      {
        "command": "janus.setNotesRoot",
        "title": "Janus: Als Notizen-Ordner festlegen"
      },
      {
        "command": "janus.resetNotesRoot",
        "title": "Janus: Notizen-Ordner zurücksetzen"
      },
      {
        "command": "janus.initNotesRoot",
        "title": "Janus: Notizen initialisieren"
      },
      {
        "command": "janus.refreshNotesTree",
        "title": "Janus: Notizen-Baum aktualisieren",
        "icon": "$(refresh)"
      },
      {
        "command": "janus.createNote",
        "title": "Janus: Neue Notiz",
        "icon": "$(new-file)"
      },
      {
        "command": "janus.createFolder",
        "title": "Janus: Neuer Ordner",
        "icon": "$(new-folder)"
      },
      {
        "command": "janus.renameItem",
        "title": "Janus: Umbenennen...",
        "icon": "$(edit)"
      },
      {
        "command": "janus.deleteItem",
        "title": "Janus: Löschen",
        "icon": "$(trash)"
      },
      {
        "command": "janus.openAllTasks",
        "title": "Janus: Alle Aufgaben öffnen",
        "icon": "$(checklist)"
      },
      {
        "command": "janus.openCalendar",
        "title": "Janus: Kalender öffnen",
        "icon": "$(calendar)"
      },
      {
        "command": "janus.openFolderTasks",
        "title": "Janus: Ordner-Aufgaben öffnen",
        "icon": "$(checklist)"
      },
      {
        "command": "janus.openFolderOverview",
        "title": "Janus: Ordnerübersicht öffnen",
        "icon": "$(dashboard)"
      },
      {
        "command": "janus.selectAiModel",
        "title": "Janus: KI-Modell auswählen / konfigurieren",
        "icon": "$(sparkle)"
      },
      {
        "command": "janus.generateTasksFromNote",
        "title": "Janus: Aufgaben mit KI aus Notiz generieren",
        "icon": "$(sparkle)"
      },
      {
        "command": "janus.sortInbox",
        "title": "Janus: Inbox mit KI einsortieren",
        "icon": "$(inbox)"
      },
      {
        "command": "janus.openSettings",
        "title": "Janus: Einstellungen öffnen",
        "icon": "$(gear)"
      },
      {
        "command": "janus.exportNoteToPdf",
        "title": "Janus: Als PDF exportieren...",
        "icon": "$(file-pdf)"
      },
      {
        "command": "janus.exportFolderToPdf",
        "title": "Janus: Ordner als Sammel-PDF exportieren...",
        "icon": "$(file-pdf)"
      },
      {
        "command": "janus.focusChatView",
        "title": "Janus: KI & Suche fokussieren",
        "icon": "$(comment-discussion)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "janus.addLinkedFolder",
          "when": "view == janus.notesView",
          "group": "navigation@0"
        },
        {
          "command": "janus.createNote",
          "when": "view == janus.notesView && janus.isInitialized",
          "group": "navigation@1"
        },
        {
          "command": "janus.createFolder",
          "when": "view == janus.notesView && janus.isInitialized",
          "group": "navigation@2"
        },
        {
          "command": "janus.refreshNotesTree",
          "when": "view == janus.notesView",
          "group": "navigation@3"
        },
        {
          "command": "janus.openSettings",
          "when": "view == janus.notesView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "janus.openFolderOverview",
          "when": "view == janus.notesView && (viewItem == janusFolder || viewItem == linkedFolder)",
          "group": "inline@0"
        },
        {
          "command": "janus.openFolderOverview",
          "when": "view == janus.notesView && (viewItem == janusFolder || viewItem == linkedFolder)",
          "group": "navigation@0"
        },
        {
          "command": "janus.createNote",
          "when": "view == janus.notesView && viewItem == janusFolder",
          "group": "inline@1"
        },
        {
          "command": "janus.createFolder",
          "when": "view == janus.notesView && viewItem == janusFolder",
          "group": "inline@2"
        },
        {
          "command": "janus.createNote",
          "when": "view == janus.notesView && viewItem == janusFolder",
          "group": "new@1"
        },
        {
          "command": "janus.createFolder",
          "when": "view == janus.notesView && viewItem == janusFolder",
          "group": "new@2"
        },
        {
          "command": "janus.openFolderTasks",
          "when": "view == janus.notesView && viewItem == janusFolder",
          "group": "new@3"
        },
        {
          "command": "janus.renameItem",
          "when": "view == janus.notesView && (viewItem == janusFolder || viewItem == janusNote)",
          "group": "modify@1"
        },
        {
          "command": "janus.deleteItem",
          "when": "view == janus.notesView && (viewItem == janusFolder || viewItem == janusNote)",
          "group": "modify@2"
        },
        {
          "command": "janus.removeLinkedFolder",
          "when": "view == janus.notesView && viewItem == linkedFolder",
          "group": "modify@3"
        },
        {
          "command": "janus.exportNoteToPdf",
          "when": "view == janus.notesView && viewItem == janusNote",
          "group": "export@1"
        },
        {
          "command": "janus.exportFolderToPdf",
          "when": "view == janus.notesView && (viewItem == janusFolder || viewItem == linkedFolder)",
          "group": "export@1"
        },
        {
          "command": "janus.exportFolderToPdf",
          "when": "view == janus.notesView && viewItem == janusNote",
          "group": "export@2"
        }
      ],
      "editor/title": [
        {
          "command": "janus.exportNoteToPdf",
          "when": "resourceExtname == .md || resourceExtname == .markdown || activeEditor == janus.markdownEditor",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "command": "janus.setNotesRoot",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        },
        {
          "command": "janus.addLinkedFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@11"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "janus.tasksEditor",
        "displayName": "Janus Task List",
        "selector": [
          {
            "filenamePattern": "tasks.json"
          },
          {
            "filenamePattern": "*.tasks.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "janus.chartEditor",
        "displayName": "Janus Diagram View",
        "selector": [
          {
            "filenamePattern": "*.chart.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "janus.markdownEditor",
        "displayName": "Janus Markdown Editor (WYSIWYG)",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "chatParticipants": [
      {
        "id": "janus",
        "name": "janus",
        "fullName": "Janus Note",
        "description": "Assistant for managing notes and companion tasks and diagrams",
        "commands": [
          {
            "name": "help",
            "description": "Zeigt eine Übersicht aller verfügbaren @janus Commands und KI-Funktionen"
          },
          {
            "name": "search",
            "description": "Durchsucht alle Notizen und Aufgaben im Workspace und beantwortet Fragen dazu"
          },
          {
            "name": "tasks",
            "description": "Zeigt offene Aufgaben im Workspace oder generiert Aufgaben aus der aktiven Notiz"
          },
          {
            "name": "summarize",
            "description": "Fasst die aktive Notiz oder einen angegebenen Ordner/Projekt zusammen"
          },
          {
            "name": "inbox",
            "description": "Analysiert die Einträge in inbox.md und bietet KI-Einsortierung an"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "janus_search_notes",
        "displayName": "Janus: Search Notes and Tasks",
        "modelDescription": "Searches all Markdown notes and folder tasks.json files in the Janus notes root by query and returns ranked note snippets and matching tasks.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Search query or keywords to look up across notes and tasks"
            },
            "maxResults": {
              "type": "number",
              "description": "Maximum number of note matches to return (default: 8)"
            }
          },
          "required": [
            "query"
          ]
        }
      },
      {
        "name": "janus_read_note_and_companions",
        "displayName": "Janus: Read Note and Companions",
        "modelDescription": "Reads the active or specified markdown note and returns its text along with attached companion files (*.tasks.json, *.chart.json).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "noteUri": {
              "type": "string",
              "description": "Optional URI or path to the markdown note. If omitted, uses active document."
            }
          }
        }
      },
      {
        "name": "janus_mutate_tasks",
        "displayName": "Janus: Mutate Tasks",
        "modelDescription": "Creates, updates, or checks off tasks in a *.tasks.json companion file with schema validation.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "noteUri": {
              "type": "string",
              "description": "URI or path to the target note or tasks companion file"
            },
            "action": {
              "type": "string",
              "enum": [
                "add",
                "update",
                "delete",
                "setAll"
              ],
              "description": "Action to perform on the task companion"
            },
            "tasks": {
              "type": "array",
              "description": "Array of task items with id, title, completed, status",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "completed": {
                    "type": "boolean"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "todo",
                      "in_progress",
                      "done"
                    ]
                  }
                },
                "required": [
                  "title"
                ]
              }
            }
          },
          "required": [
            "noteUri",
            "action"
          ]
        }
      },
      {
        "name": "janus_mutate_chart",
        "displayName": "Janus: Mutate Chart",
        "modelDescription": "Creates or updates a *.chart.json companion file with diagram syntax (such as Mermaid).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "noteUri": {
              "type": "string",
              "description": "URI or path to the target note or chart companion file"
            },
            "chartType": {
              "type": "string",
              "description": "Type of diagram (e.g. mermaid, flowchart)"
            },
            "code": {
              "type": "string",
              "description": "Mermaid diagram code or chart definition"
            }
          },
          "required": [
            "noteUri",
            "code"
          ]
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./ --noEmit",
    "watch": "node esbuild.js --watch",
    "build": "node esbuild.js",
    "test": "vitest run",
    "package": "vsce package --no-git-tag-version",
    "release": "./release.sh"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@mdi/js": "^7.4.47",
    "@radix-ui/react-slot": "^1.5.0",
    "@types/d3": "^7.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror-markdown-tables": "^1.0.1",
    "d3": "^7.9.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
